DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-client-id

# Recommended while testing: commands update instantly for this one server.
# Remove this line later if you want global commands.
DISCORD_GUILD_ID=replace-with-your-discord-server-id

YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
